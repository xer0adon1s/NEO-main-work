# Live engagement data — never commit box findings
projects/*
!projects/.gitkeep

# VPN profiles may contain credentials
vpn/*
!vpn/.gitkeep

# Session cheat sheets / scratch output
results/*

# Large wordlists — fetch separately (see README)
wordlists/*.txt
!wordlists/.gitkeep

# Third-party tools — fetched by ./setup.sh
vendor/*
!vendor/.gitkeep

# Secrets — never commit API keys or credential material
.env
.env.*
*.pem
*.key

# lib/ must only contain NEO scripts — ignore accidental system-lib pollution
lib/*
!lib/notes-lib.sh
!lib/script-lib.sh
