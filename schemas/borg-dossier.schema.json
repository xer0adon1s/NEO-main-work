{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NEO Borg assimilated dossier",
  "type": "object",
  "required": ["schema_version", "vectors"],
  "properties": {
    "schema_version": { "const": 1 },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "sources", "tool_inventory", "operator_actions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "title": { "type": "string" },
          "applicability": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "verification_questions": { "type": "array", "items": { "type": "string" } },
          "research_status": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "url": { "type": "string" },
                "title": { "type": "string" },
                "supports": { "type": "string" }
              }
            }
          },
          "tool_inventory": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "purpose": { "type": "string" },
                "installed": {}
              }
            }
          },
          "operator_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "risk"],
              "properties": {
                "title": { "type": "string" },
                "description": { "type": "string" },
                "risk": { "type": "string" },
                "expected_evidence": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
