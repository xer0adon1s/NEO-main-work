{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo.local/schemas/action.schema.json",
  "title": "NEO operator action",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "title", "description", "risk", "source", "execution"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "kind": { "enum": ["manual", "local_command"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "risk": { "enum": ["read_only", "state_change", "invasive"] },
    "source": { "enum": ["builtin", "operator", "ai"] },
    "target": { "type": ["string", "null"], "maxLength": 255 },
    "expected_evidence": { "type": ["string", "null"], "maxLength": 1000 },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["advisory", "approved_local"] },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 8192 }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "cwd": { "type": ["string", "null"], "maxLength": 4096 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "local_command" } } },
      "then": { "properties": { "execution": { "required": ["argv", "timeout_seconds"] } } }
    }
  ]
}
