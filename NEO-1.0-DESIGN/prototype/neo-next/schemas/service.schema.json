{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo.local/schemas/service.schema.json",
  "title": "NEO discovered service",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "port", "protocol", "service"],
  "properties": {
    "host": { "type": "string", "minLength": 1, "maxLength": 255 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "protocol": { "enum": ["tcp", "udp"] },
    "service": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,80}$" },
    "tls": { "type": "boolean" },
    "product": { "type": ["string", "null"], "maxLength": 255 },
    "version": { "type": ["string", "null"], "maxLength": 255 },
    "evidence_ref": { "type": ["string", "null"], "maxLength": 4096 }
  }
}
